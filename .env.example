# ============================================================
# Amamma Jaadi — Environment Variables
# Copy to .env.local and fill in real values
# NEVER commit .env.local to Git
# ============================================================

# ── Admin Authentication ─────────────────────────────────────
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password
ANALYTICS_PIN=your_analytics_pin
SESSION_SECRET=your_64_char_random_string

# ── Database ─────────────────────────────────────────────────
# Cloudflare D1 is bound to the Worker as `DB` (see wrangler.jsonc); no
# connection string or key is needed here. Schema: src/lib/d1-schema.sql

# ── Square Payments ──────────────────────────────────────────
SQUARE_ACCESS_TOKEN=your_square_access_token
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=your_square_webhook_signature_key
SQUARE_WEBHOOK_URL=https://yourdomain.com/api/payments/webhook
NEXT_PUBLIC_SQUARE_APP_ID=your_square_application_id
NEXT_PUBLIC_SQUARE_LOCATION_ID=your_square_location_id
# Loads the matching Web Payments SDK on the client (sandbox | production)
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox

# ── Transactional Email ──────────────────────────────────
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=orders@yourdomain.com
# D1 + EMAIL_QUEUE are configured in wrangler.jsonc; failed deliveries remain
# in the durable outbox and are retried after temporary provider outages.
# Optional order-confirmation copy recipients (comma-separated).
ORDER_CONFIRMATION_BCC_EMAIL=business@yourdomain.com
# Owner inbox(es), comma-separated — notified directly when the customer gave
# no email and copied on event inquiries (skipped if unset).
OWNER_NOTIFICATION_EMAIL=owner@yourdomain.com,second-owner@yourdomain.com

# ── App Config ───────────────────────────────────────────────
# NOTE: the public site origin is NOT configured here. It's a constant in
# src/lib/constants.ts (SITE_URL), because emails and SEO metadata must always
# use the production domain — a build-time env var once leaked localhost into
# customer emails and broke the logo.
NEXT_PUBLIC_WHATSAPP_NUMBER=your_whatsapp_number
