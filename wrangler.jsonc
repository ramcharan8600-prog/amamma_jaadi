{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "amammajaadi",
  "compatibility_date": "2026-06-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Non-secret runtime config. Lives here (not the dashboard) because
  // `wrangler deploy` deletes dashboard-added plaintext vars on every deploy
  // — only values in this file and dashboard Secrets survive. Secrets
  // (SQUARE_ACCESS_TOKEN, SESSION_SECRET, ...) stay in the dashboard.
  "keep_vars": true,
  "vars": {
    "SQUARE_ENVIRONMENT": "production",
    // Square public (non-secret) config — client Web Payments SDK reads these
    // from the runtime Worker env (see src/lib/square.ts). Kept here in config
    // (not only the dashboard) so every deploy carries them reliably.
    "NEXT_PUBLIC_SQUARE_ENVIRONMENT": "production",
    "NEXT_PUBLIC_SQUARE_APP_ID": "sq0idp-nQcHJJ0deLrkQXFT7rPuCw",
    "NEXT_PUBLIC_SQUARE_LOCATION_ID": "L91NP356QX30A",
    "SQUARE_WEBHOOK_URL": "https://amammajaadi.com/api/payments/webhook",
    "OWNER_NOTIFICATION_EMAIL": "ramcharan8600@gmail.com,amammajaadi@gmail.com",
    "FROM_EMAIL": "orders@amammajaadi.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amammajaadi",
      "database_id": "9b65d2d1-e6cc-4e0d-8520-62a3af2288b2"
    }
  ],
  // Isolated Square Sandbox deployment. Bindings and vars are repeated because
  // Wrangler environments do not inherit them from the default environment.
  // The Sandbox access token is stored as a Worker secret and never committed.
  "env": {
    "sandbox": {
      "name": "amammajaadi-sandbox",
      "workers_dev": true,
      "vars": {
        "SQUARE_ENVIRONMENT": "sandbox",
        "NEXT_PUBLIC_SQUARE_ENVIRONMENT": "sandbox",
        "NEXT_PUBLIC_SQUARE_APP_ID": "sandbox-sq0idb-WKS7geC_1fepLwLEC51lsw",
        "NEXT_PUBLIC_SQUARE_LOCATION_ID": "LHGDKWDQK2SA6",
        "SQUARE_WEBHOOK_URL": "https://amammajaadi-sandbox.ramcharan8600.workers.dev/api/payments/webhook",
        "OWNER_NOTIFICATION_EMAIL": "",
        "FROM_EMAIL": "sandbox@amammajaadi.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "amammajaadi-sandbox",
          "database_id": "070bb231-cca0-42e6-9df8-5f05449a424a"
        }
      ]
    }
  },
  "observability": {
    "enabled": true
  }
}
